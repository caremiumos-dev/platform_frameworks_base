        "id": 1081378
      },
      "writtenOn": "2015-09-11T21:16:37Z",
      "side": 1,
      "message": "If you take my earlier suggestion to describe the code above as assembly language, you could rephrase this as something like \"When programming in a higher-level language, the compiler can reorder instructions just like the hardware can\", and then present a fresh example that parallels the one above, but doesn\u0027t talk about things like registers that aren\u0027t available in higher-level languages.",
      "range": {
        "startLine": 217,
        "startChar": 3,
        "endLine": 218,
        "endChar": 22
      },
      "revId": "00e2d2be4a60d6fc010d531dfe48781574fd9428",
