        "id": 1339996
      },
      "writtenOn": "2020-07-16T17:32:51Z",
      "side": 1,
      "message": "The system property cannot change while the device is running since it is read-only, correct? If so, this should return a singleton instance.",
      "range": {
        "startLine": 111,
        "startChar": 37,
        "endLine": 111,
        "endChar": 52
      },
      "revId": "c961228e0c49af2dfc672c098faf7453da2eff08",
