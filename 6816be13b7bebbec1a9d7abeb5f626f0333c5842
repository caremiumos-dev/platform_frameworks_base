      "writtenOn": "2021-11-19T06:28:48Z",
      "side": 1,
      "message": "It\u0027s the version number that we used it when restoring NetworkTemplate from bytes.\nVERSION_# would do the trick, but with a meaningful name it should be more readible.\nTry to add comment and rename to make it more readible.\nSee if it works for you.",
      "parentUuid": "4dce05da_5584e474",
      "range": {
        "startLine": 71,
        "startChar": 29,
        "endLine": 71,
        "endChar": 41
      },
      "revId": "6816be13b7bebbec1a9d7abeb5f626f0333c5842",
