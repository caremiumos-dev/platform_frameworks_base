      "side": 1,
      "message": "I\u0027m not sure this is an appropriate use of hasSystemFeature. What kind of app would care about whether a device has this feature available and why?",
      "revId": "4ff267e9f4c086f861b8997fe908a770291a9210",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "bb44e7e0_c8262216",
        "filename": "/PATCHSET_LEVEL",
        "patchSetId": 2
      },
      "lineNbr": 0,
